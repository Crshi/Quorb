{
  "manifest_version": 3,
  "name": "quorb — AI 用量悬浮球",
  "version": "0.8.0",
  "description": "液态玻璃悬浮球 + 侧边栏面板：一眼看尽 GLM Coding Plan 的 5 小时窗口与周用量。密钥仅存本机。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://bigmodel.cn/*",
    "https://open.bigmodel.cn/*",
    "https://*.bigmodel.cn/*",
    "https://api.z.ai/*",
    "https://*.z.ai/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "side_panel": {
    "default_path": "src/sidepanel/panel.html"
  },
  "action": {
    "default_title": "quorb · 打开侧边栏"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "dist/content/index.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/ui.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
